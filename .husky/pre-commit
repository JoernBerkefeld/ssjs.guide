if [[ $SKIP_HOOKS -gt 0 ]]; then
  echo "[PRE-COMMIT] skipping hooks (SKIP_HOOKS=$SKIP_HOOKS)"
  exit 0
fi

# ── Free the local Jekyll port (must stay first + synchronous) ────────────────
# A local `jekyll serve` watcher would re-touch files while the generators below
# write them, racing the commit. Kill only the process listening on THIS site's
# fixed port (4001) so a co-running sibling site's server survives. Runs in the
# FOREGROUND (no `&`) so sh blocks until the kill fully completes, then a short
# sleep lets the just-terminated server release the port and file handles before
# the generators touch files. Non-fatal: if nothing is listening the PowerShell
# pipeline is a no-op and the commit proceeds.
echo "[PRE-COMMIT] Ensuring no local Jekyll server holds port 4001 (waiting for kill to complete)..."
powershell.exe -NoProfile -Command "Get-NetTCPConnection -LocalPort 4001 -State Listen -ErrorAction SilentlyContinue | Select-Object -Expand OwningProcess -Unique | ForEach-Object { Stop-Process -Id \$_ -Force -ErrorAction SilentlyContinue }" 2>/dev/null || true
sleep 1 || true

# ── Regenerate site-index.json ────────────────────────────────────────────────
# The index is built by ssjs-data (single source of truth) and written into this
# repo. ssjs-data's own hook stages only its dist/ copy, so without this step the
# copy here can silently ship stale. The generator runs in well under a second and
# is idempotent, so it runs on every commit rather than guessing which inputs
# matter — the inputs live in another repo and a wrong guess reintroduces exactly
# the stale-artifact bug this hook exists to prevent.
echo "[PRE-COMMIT] 🔄 Regenerating site-index.json..."
node scripts/regenerate-site-index.mjs || {
  echo "[PRE-COMMIT] ❌ The site search index could not be generated, so the commit was blocked"
  echo "[PRE-COMMIT]    to stop a stale site-index.json from being committed."
  echo "[PRE-COMMIT]    See the error above — usually a page was added, renamed or moved"
  echo "[PRE-COMMIT]    without a matching update to ssjs-data/src/urls.js."
  exit 1
}

# Re-staging is the whole point: regenerating without `git add` would still
# commit the stale blob that was staged before the hook ran.
git add site-index.json || {
  echo "[PRE-COMMIT] ❌ Could not stage the regenerated site-index.json. See the error above."
  exit 1
}
echo "[PRE-COMMIT] ✅ site-index.json regenerated and staged."

# ── Regenerate _data/ssjs_functions.yml ───────────────────────────────────────
# The /function-index/ table is data-driven: its rows come from ssjs-data via the
# same catalog traversal that builds site-index.json. Same staleness risk, same
# treatment — regenerate on every commit and re-stage.
echo "[PRE-COMMIT] 🔄 Regenerating _data/ssjs_functions.yml..."
node scripts/regenerate-function-index.mjs || {
  echo "[PRE-COMMIT] ❌ The function index data could not be generated, so the commit was"
  echo "[PRE-COMMIT]    blocked to stop a stale _data/ssjs_functions.yml from being committed."
  echo "[PRE-COMMIT]    See the error above."
  exit 1
}

git add _data/ssjs_functions.yml || {
  echo "[PRE-COMMIT] ❌ Could not stage the regenerated _data/ssjs_functions.yml. See above."
  exit 1
}
echo "[PRE-COMMIT] ✅ _data/ssjs_functions.yml regenerated and staged."

# ── Strip UTF-8 BOMs (must stay last) ─────────────────────────────────────────
# Runs after everything else that writes files, so a BOM re-introduced by the
# generator still gets caught. A BOM before a page's opening `---` silently breaks
# Jekyll frontmatter parsing.
echo "[PRE-COMMIT] Checking staged files for UTF-8 BOMs..."
node scripts/check-bom.mjs || {
  echo "[PRE-COMMIT] ❌ BOM check failed. See the message above."
  exit 1
}

echo "[PRE-COMMIT] All checks passed."
